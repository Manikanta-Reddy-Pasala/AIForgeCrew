# AIForge — the fixed environment. Committed, identical on every box.
#
# run.sh READS this file and never writes to it. A script that edits its own
# configuration gives you two sources of truth and a machine whose behaviour
# depends on what some earlier run happened to append.
#
# THE ENVIRONMENT WINS. Anything already set when run.sh starts — a systemd
# unit, `docker -e`, a shell export — is left alone, so this file holds what is
# the same everywhere and the environment carries what differs per box.
#
# Format is plain KEY=VALUE; it is parsed, not sourced, so a value with a `$`
# or a backtick in it is a value, not a command.
#
# Every available variable is catalogued in .env.example. This file is only the
# handful that have a fixed answer.

# ── Network ───────────────────────────────────────────────────────────────
# May a package manager fetch on this box — PyPI, npm, docker, apt?
#   1  never downloads
#   0  package managers may fetch (how a box is bootstrapped or upgraded)
# Either way run.sh never downloads a source and executes it: uv and Node are
# Python dependencies, never an installer piped into a shell.
AIFORGE_OFFLINE=1

# ── Model endpoint ────────────────────────────────────────────────────────
# The default for a box that runs its model locally. Override per box with
# AIFORGE_LM_BASE_URL in the environment, or set it on the home page.
# API KEYS DO NOT BELONG HERE — this file is committed. Put them in the
# environment, or in Settings (stored 0600 under $AIFORGE_CONFIG_DIR/security).
AIFORGE_LM_BASE_URL=http://127.0.0.1:1234/v1

# Verification stays ON. For an internal CA, load the root AND its
# intermediates in Settings → Local certificate authority, or point
# AIFORGE_CA_BUNDLE at a PEM. run.sh merges it with the platform's own roots
# before installing anything, so public hosts keep working.
AIFORGE_LLM_SSL_VERIFY=true

# ── Memory sync ───────────────────────────────────────────────────────────
# Hub and spoke: every machine compacts its own memory, ONE machine merges
# across the fleet. Both of these are per-box, so they live in the environment
# of the unit that starts run.sh — NOT here, or every box would claim the same
# role:
#
#   AIFORGE_ROLE=admin                    on exactly one machine
#   AIFORGE_ADMIN_URL=http://<admin>:8799 on every other machine
#
# A machine that stops being the admin retires its own merged fold and
# tombstones it to every spoke, so the role must survive a restart. `--admin`
# on the command line claims it for one run only and warns about exactly that.

# ── Agent scope ───────────────────────────────────────────────────────────
# The chat agent has full filesystem and shell access by default. Clamp it to
# one directory by setting AIFORGE_WORKSPACE_DIR in the environment.
