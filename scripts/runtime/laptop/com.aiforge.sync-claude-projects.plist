<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AIForge laptop ↔ NUC Claude project memory sync. Runs every 30
  min from launchd. Install:

      cp scripts/runtime/sync-claude-memory.sh \
         ~/.local/libexec/aiforge/sync-claude-projects.sh
      chmod +x ~/.local/libexec/aiforge/sync-claude-projects.sh
      cp scripts/runtime/laptop/com.aiforge.sync-claude-projects.plist \
         ~/Library/LaunchAgents/
      launchctl load -w ~/Library/LaunchAgents/com.aiforge.sync-claude-projects.plist

  IMPORTANT (macOS TCC quirk): the script must live under
  ~/.local/libexec/aiforge/ rather than under ~/Documents/ because
  launchd-spawned processes are TCC-blocked from ~/Documents on
  modern macOS — they hit "Operation not permitted" silently.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiforge.sync-claude-projects</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>/Users/manip/.local/libexec/aiforge/sync-claude-projects.sh &gt;&gt; /Users/manip/Library/Logs/aiforge-sync-claude-projects.log 2&gt;&amp;1</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/manip/Library/Logs/aiforge-sync-claude-projects.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/manip/Library/Logs/aiforge-sync-claude-projects.log</string>
</dict>
</plist>
