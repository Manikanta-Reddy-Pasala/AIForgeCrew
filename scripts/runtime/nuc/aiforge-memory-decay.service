[Unit]
Description=AIForge memory decay (archive stale facts)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AIForgeCrew
EnvironmentFile=%h/.aiforge/runtime.env
ExecStart=%h/AIForgeCrew/.venv/bin/python -m aiforge_core.cli.maintenance memory decay
StandardOutput=journal
StandardError=journal
