[Unit]
Description=AIForge sandbox via run.sh
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
WorkingDirectory=%h/AIForgeCrew
# run.sh is the single source of truth for env wiring and for bringing the box
# up — do NOT duplicate that here as hardcoded Environment= lines, they drift.
# It reads %h/AIForgeCrew/aiforge.env itself; only --host needs passing, because
# run.sh's own HOST default (127.0.0.1) is a shell variable, not something the
# env file can override.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# There is no host mode. run.sh starts the sandbox and returns, so this unit is
# oneshot + RemainAfterExit: what actually serves the API is the container, kept
# alive by its own `restart: unless-stopped`, not by systemd re-running this.
# (It used to run the API on the host, which is why it needed to BE the process.)
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/AIForgeCrew/run.sh --host 0.0.0.0
ExecStop=%h/AIForgeCrew/run.sh --stop

[Install]
WantedBy=default.target
