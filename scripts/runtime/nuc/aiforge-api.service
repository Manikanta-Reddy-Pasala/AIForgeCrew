[Unit]
Description=AIForge FastAPI (uvicorn :8799)
After=network-online.target postgresql.service

[Service]
WorkingDirectory=%h/AIForgeCrew
Environment=AIFORGE_DSN=postgresql://aiforge:aiforgepass@127.0.0.1:5432/aiforge
Environment=AIFORGE_LM_BASE_URL=http://127.0.0.1:1235/v1
Environment=AIFORGE_NEO4J_URI=bolt://127.0.0.1:7687
ExecStart=%h/AIForgeCrew/.venv/bin/python -m uvicorn aiforge_core.api.api:app --host 0.0.0.0 --port 8799
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
