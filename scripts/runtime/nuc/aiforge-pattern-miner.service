[Unit]
Description=AIForge pattern miner (promote 3+ similar Doer outcomes to T3)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AIForgeCrew
EnvironmentFile=%h/.aiforge/runtime.env
ExecStart=%h/AIForgeCrew/.venv/bin/python -m aiforge_core.runtime.maintenance_cli memory mine
StandardOutput=journal
StandardError=journal
