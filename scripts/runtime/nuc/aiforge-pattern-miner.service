[Unit]
Description=AIForge pattern miner (promote 3+ similar Doer outcomes to T3)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mani/AIForgeCrew
EnvironmentFile=/home/mani/.aiforge/runtime.env
ExecStart=/home/mani/AIForgeCrew/.venv/bin/python -m aiforge_core.runtime.maintenance_cli memory mine
StandardOutput=journal
StandardError=journal
