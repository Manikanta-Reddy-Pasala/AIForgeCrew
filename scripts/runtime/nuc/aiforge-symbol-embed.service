[Unit]
Description=AIForge symbol embeddings backfill
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AIForgeCrew
EnvironmentFile=%h/.aiforge/runtime.env
ExecStart=%h/AIForgeCrew/.venv/bin/python -m aiforge_core.runtime.maintenance_cli index symbols --batch 500
StandardOutput=journal
StandardError=journal
