[Unit]
Description=AIForge daily reindex

[Service]
Type=oneshot
WorkingDirectory=%h/AIForgeCrew
# The DSN carries a password, so it lives OUTSIDE git in an env file
# (chmod 600). Inline here, the credential shipped with the repo.
EnvironmentFile=%h/.aiforge/pg.env
Environment=HOME=%h
ExecStart=/bin/bash -lc "cd ~/AIForgeCrew && git pull && .venv/bin/python scripts/runtime/reindex-daily.py"
