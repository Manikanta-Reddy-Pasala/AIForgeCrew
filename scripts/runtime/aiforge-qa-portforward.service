[Unit]
Description=AIForge QA cluster port-forwards (Mongo/Redis/NATS/MongoDbService/etc.)
After=network-online.target

[Service]
Type=simple
ExecStart=/home/mani/AIForgeCrew/scripts/runtime/aiforge-qa-portforward.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/mani/.aiforge/logs/qa-pf.out
StandardError=append:/home/mani/.aiforge/logs/qa-pf.err

[Install]
WantedBy=default.target
