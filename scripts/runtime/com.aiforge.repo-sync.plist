<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.aiforge.repo-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/rsync</string>
        <string>-az</string>
        <string>--delete</string>
        <string>--exclude</string><string>target</string>
        <string>--exclude</string><string>build</string>
        <string>--exclude</string><string>node_modules</string>
        <string>--exclude</string><string>.aiforge-worktrees</string>
        <string>--exclude</string><string>.idea</string>
        <string>--exclude</string><string>.gradle</string>
        <string>--exclude</string><string>dist</string>
        <string>--exclude</string><string>.venv</string>
        <string>/Users/manikanta/codeRepo/</string>
        <string>mani@192.168.70.191:/home/mani/codeRepo/</string>
    </array>
    <key>StartInterval</key><integer>300</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key>
    <string>/Users/manikanta/.aiforge/logs/repo-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/manikanta/.aiforge/logs/repo-sync.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
