<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aiforge.repo-indexer</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/manikanta/AIForgeCrew/.venv/bin/python</string>
    <string>-m</string>
    <string>aiforge_core.rag.repo_catalog</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/manikanta/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>AIFORGE_MEMORY_BACKEND</key>
    <string>neo4j</string>
    <key>AIFORGE_NEO4J_URI</key>
    <string>bolt://127.0.0.1:7688</string>
    <key>AIFORGE_NEO4J_USER</key>
    <string>neo4j</string>
    <key>AIFORGE_NEO4J_PASSWORD</key>
    <string>password</string>
    <key>AIFORGE_CODE_ROOT</key>
    <string>/Users/manikanta/codeRepo</string>
  </dict>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Users/manikanta/.aiforge/logs/repo-indexer.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/manikanta/.aiforge/logs/repo-indexer.err</string>

  <key>WorkingDirectory</key>
  <string>/Users/manikanta/AIForgeCrew</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
