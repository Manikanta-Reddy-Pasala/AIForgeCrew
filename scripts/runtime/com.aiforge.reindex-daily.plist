<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.aiforge.reindex-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd $HOME/AIForgeCrew &amp;&amp; git pull &amp;&amp; .venv/bin/python scripts/runtime/reindex-daily.py 2>&amp;1</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>2</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key>
    <string>/Users/manikanta/.aiforge/logs/reindex-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/manikanta/.aiforge/logs/reindex-daily.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/manikanta/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AIFORGE_DSN</key>
        <string>postgresql://aiforge:aiforgepass@192.168.70.191:5432/aiforge</string>
    </dict>
</dict>
</plist>
