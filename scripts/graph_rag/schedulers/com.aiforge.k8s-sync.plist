<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aiforge.k8s-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd ~/Documents/codeRepo/AIForgeCrew/scripts/graph_rag &amp;&amp; \
~/aiforge-venv/bin/python k8s_sync.py --env qa --kubeconfig ~/.kubeconfigs/qa.yaml --context qa &gt; /tmp/graph_rag/k8s-qa.jsonl &amp;&amp; \
~/aiforge-venv/bin/python ingest_k8s.py /tmp/graph_rag/k8s-qa.jsonl</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>/tmp/aiforge-k8s-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/aiforge-k8s-sync.err</string>
</dict>
</plist>
