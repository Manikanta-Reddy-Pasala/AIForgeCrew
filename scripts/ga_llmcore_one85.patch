+class ToolCallAdapter:
+    """Normalize tool calls between native and text formats (2026-05).
+
+    Three call sites today emit tool calls into a session:
+
+    1. **Native OpenAI / Ollama Cloud / LM Studio** — return a
+       ``message.tool_calls[]`` array. Our SSE/JSON parsers convert each
+       entry into a ``{"type":"tool_use", "id", "name", "input"}`` block.
+    2. **Native Anthropic** — same content-block shape from the SSE
+       parser (``_parse_claude_sse``).
+    3. **Legacy mlx-lm 0.31** — emits ``finish_reason=tool_calls`` but a
+       broken empty ``tool_calls[]``. The model puts the call inline in
+       text content as ``<tool_use>{...}</tool_use>`` or
+       ``[{"type":"tool_use", "name":..., "input":...}]``.
+
+    ``ToolCallAdapter`` normalizes all three into a uniform list of
+    ``MockToolCall`` plus cleaned content, so callers (NativeClaudeSession,
+    NativeOAISession, ToolClient) don't have to re-implement the priority
+    rule.
+
+    **Priority**: native blocks beat text blocks. If the model emits both
+    (rare; observed on hybrid setups), the native ones are returned and
+    the inline text markers are stripped from ``content``.
+    """
+
+    @staticmethod
+    def from_native(tool_blocks):
+        """Convert content-block tool_use entries → list[MockToolCall].
+
+        ``tool_blocks`` is the output of _parse_openai_sse / _parse_claude_sse —
+        a list of dicts with ``type`` ∈ {text, thinking, tool_use}. Only
+        tool_use entries become MockToolCall.
+        """
+        return [MockToolCall(b.get("name", ""), b.get("input", {}), id=b.get("id", ""))
+                for b in (tool_blocks or []) if isinstance(b, dict) and b.get("type") == "tool_use"]
+
+    @staticmethod
+    def from_text(content):
+        """Inline-text tool-call extractor. Wraps _parse_text_tool_calls.
+
+        Returns ``(list[MockToolCall], cleaned_content)``. Used as the
+        fallback when native blocks are absent (mlx-lm 0.31 bug etc.).
+        """
+        return _parse_text_tool_calls(content or "")
+
+    @staticmethod
+    def merge(content, content_blocks):
+        """Native-first merge.
+
+        Args:
+            content: assistant text from streamed/non-streamed reply
+                (already accumulated, may include inline ``<tool_use>``).
+            content_blocks: parser output (list of content-block dicts).
+
+        Returns:
+            ``(cleaned_content, tool_calls)`` where ``tool_calls`` is a
+            list of MockToolCall (possibly empty). Native blocks win;
+            if native is empty, fall back to text parsing of ``content``.
+            When native blocks ARE present, inline ``<tool_use>`` /
+            ``<tool_call>`` text in content is stripped to avoid the
+            doer dispatching the same call twice.
+        """
+        native = ToolCallAdapter.from_native(content_blocks)
+        if native:
+            # Strip inline markers (defensive — usually content is clean).
+            cleaned = re.sub(r"<(?:tool_use|tool_call)>[\s\S]*?</(?:tool_use|tool_call)>", "", content or "").strip()
+            return cleaned, native
+        text_calls, cleaned = ToolCallAdapter.from_text(content or "")
+        return cleaned, text_calls
+
+
+def detect_mlx_lm_tool_call_bug(api_response_data):
+    """Sniff for the mlx-lm 0.31 native-tool_calls serialization bug.
+
+    Symptom: ``finish_reason=tool_calls`` but ``message.tool_calls`` is
+    empty/None AND ``message.content`` is empty/whitespace. The model
+    intended to emit a tool call but the runtime dropped the array on
+    serialization. Documented at <upstream mlx-lm issue tracker>.
+
+    Args:
+        api_response_data: parsed JSON dict from non-streamed
+            ``chat.completions`` response.
+
+    Returns:
+        bool — True when the bug is detected, False otherwise.
+
+    Caller responsibility: when True, re-issue the call with
+    ``response_format={"type":"json_object"}`` plus a system addendum
+    asking for the tool call inline as JSON, then text-parse the
+    result. This module emits a single WARN per detection.
+    """
+    if not isinstance(api_response_data, dict): return False
+    choices = api_response_data.get("choices") or []
+    if not choices: return False
+    ch = choices[0] or {}
+    if ch.get("finish_reason") != "tool_calls": return False
+    msg = ch.get("message") or {}
+    has_native = bool(msg.get("tool_calls"))
+    has_content = bool((msg.get("content") or "").strip())
+    detected = (not has_native) and (not has_content)
+    if detected:
+        print("[WARN] mlx-lm 0.31 native-tool_calls bug detected: finish_reason=tool_calls but tool_calls[] empty & content empty. "
+              "Caller should retry with response_format=json_object + inline JSON system addendum.")
+    return detected
+
