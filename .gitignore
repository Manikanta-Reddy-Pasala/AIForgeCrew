# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Python
__pycache__/
*.py[cod]
# No trailing slash: `.venv/` matches a DIRECTORY only, so a `.venv`
# SYMLINK into a shared venv (a natural thing to do inside a worktree) was
# not ignored and got committed once. Match both.
.venv
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.npm/
.yarn/

# Secrets (NEVER commit)
.env
.env.*
!.env.example
!.env.test.example
aiforge.env
!aiforge.env.example
secrets/
config/prod/

# Models (huge, external)
models/
*.gguf
*.safetensors
*.bin

# Runtime
logs/
*.log
.aiforge/

# Tooling local state
.claude/

# Build artifacts
coverage/
.coverage
htmlcov/

# Vite build output
web/dist/
web/node_modules/

# Graphify intermediates
graphify-out/cache/
graphify-out/*.log
graphify-out/
.playwright-mcp/

# aider tree-sitter repo-map cache (repo_map tool)
.aider.tags.cache.v*/
.aider.tags.cache*

# git worktrees (superpowers:using-git-worktrees)
.worktrees/

# brainstorming visual companion
.superpowers/

# Runtime data created by the app (local Docker binds + local runs) — never commit
neo4j-data/
neo4j-logs/
data/
pgdata/
state/
ticket-files/
aiforge_workspace/
# SQLite stores the app opens at runtime (jobs/chat/memory/checkpoints)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
aiforge_core/web_dist/

# CI build output: pytest's junit xml + the copies the Sonar scanner reads.
# Untracked AND excluded from Sonar indexing (sonar-project.properties) — the
# scanner would otherwise analyse the build's own reports as XML source.
test-results/
sonar/
.scannerwork/
