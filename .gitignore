# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.npm/
.yarn/

# Secrets (NEVER commit)
.env
.env.*
!.env.example
!.env.test.example
aiforge.env
!aiforge.env.example
secrets/
config/prod/

# Models (huge, external)
models/
*.gguf
*.safetensors
*.bin

# Runtime
logs/
*.log
.aiforge/

# Tooling local state
.claude/

# Build artifacts
coverage/
.coverage
htmlcov/

# Vite build output — web/node_modules ignored, but web/dist is COMMITTED so a
# `git pull` ships the current built UI to deploy boxes that have no npm to
# rebuild it (the #1 "I pulled but the UI didn't change" cause). Re-include it
# past the broad `dist/` rule above.
web/node_modules/
!web/dist/
!web/dist/**

# Graphify intermediates
graphify-out/cache/
graphify-out/*.log
graphify-out/
.playwright-mcp/

# aider tree-sitter repo-map cache (repo_map tool)
.aider.tags.cache.v*/
.aider.tags.cache*

# git worktrees (superpowers:using-git-worktrees)
.worktrees/

# brainstorming visual companion
.superpowers/

# Runtime data created by the app (local Docker binds + local runs) — never commit
neo4j-data/
neo4j-logs/
data/
pgdata/
state/
ticket-files/
aiforge_workspace/
# SQLite stores the app opens at runtime (jobs/chat/memory/checkpoints)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
