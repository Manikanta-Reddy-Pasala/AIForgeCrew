# AIForge environment — copy to `.env` and edit:  cp .env.example .env
# `./run.sh` sources this automatically. Lines are KEY=value (no export/quotes).
# NEVER commit a real `.env` — it's gitignored.
#
# SINGLE MODE: everything runs on the host with embedded SQLite + scoped-OKR
# Markdown memory + Aider RepoMap + CodeGraph. No Postgres/Neo4j/Docker.
# The ONLY thing you MUST set is the model endpoint below.

# ──────────────────────────── Model endpoint (REQUIRED) ──────────────
# OpenAI-compatible base_url for your model. LM Studio / vLLM / Ollama /
# llama.cpp / TGI / LiteLLM all work. Use https:// for a TLS-fronted box.
AIFORGE_LM_BASE_URL=http://127.0.0.1:1234/v1
# API key for the endpoint (blank for keyless local servers).
# AIFORGE_LM_API_KEY=

# Per-role model endpoints (optional — one served model per role):
#   AIFORGE_DOER_BASE_URL=http://127.0.0.1:1234/v1
#   AIFORGE_PLANNER_BASE_URL=http://127.0.0.1:1235/v1
#   AIFORGE_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1   # fallback for all roles
#   AIFORGE_OPENAI_COMPAT_API_KEY=

# ─────────────────────────────── TLS / SSL ───────────────────────────
# Applies only to AIForge's own self-hosted services (model endpoint, MCP,
# local probes). Public hosts (GitHub, web fetches) are ALWAYS verified.
# Keep verify ON and trust an internal CA:
#   AIFORGE_LLM_CA_BUNDLE=/path/to/internal-ca.pem
# OR relax it for an internal/LAN box you control (default: true):
AIFORGE_LLM_SSL_VERIFY=true

# ───────────────────────────── CodeGraph (optional) ──────────────────
# Comma-separated repo paths to index for the enforced codegraph_* tools.
# The binary auto-installs (npm @colbymchenry/codegraph). Empty = skip.
# AIFORGE_CODEGRAPH_REPOS=/path/repoA,/path/repoB
# AIFORGE_CODEGRAPH_BIN=/custom/path/to/codegraph   # if not on PATH

# ──────────────────────────── Tracing (optional) ─────────────────────
# Self-hosted Langfuse trace UI — the ONE optional Docker piece. Enable with
# `./run.sh --with-langfuse` or:
# AIFORGE_LANGFUSE=1

# ─────────────────────────────── Misc (optional) ─────────────────────
# Clamp the chat agent's filesystem scope (default: UNRESTRICTED host access):
# AIFORGE_WORKSPACE_DIR=/path/to/allowed/workspace
# Listen host/port (defaults 127.0.0.1:8799):
# AIFORGE_HOST=127.0.0.1
# AIFORGE_PORT=8799

# ─────────────────────── External Postgres (rare, opt-in) ────────────
# The app is SQLite-only by default. To use a real external Postgres INSTEAD,
# set BOTH (a stale AIFORGE_PG_URL alone is ignored):
# AIFORGE_KEEP_PG=1
# AIFORGE_PG_URL=postgresql://user:pass@host:5432/aiforge
