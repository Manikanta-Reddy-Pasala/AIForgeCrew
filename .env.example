# AIForge local environment — copy to `.env` (or `aiforge.env`) and edit.
#   cp .env.example .env
# `./run.sh` sources this automatically (set -a auto-exports every key).
# NEVER commit a real `.env` / `aiforge.env` — they are gitignored.
# Lines are `KEY=value`; no `export`, no quotes needed for simple values.

# ──────────────────────────── Model endpoint ─────────────────────────
# The OpenAI-compatible base_url AIForge points the model role(s) at.
# Self-hosted vLLM / LM Studio / Ollama / TGI / LiteLLM all work here.
# Use https:// for a TLS-fronted self-hosted box.
AIFORGE_LM_BASE_URL=https://your-self-hosted-box:1234/v1
# Optional API key for the endpoint (blank for keyless OSS endpoints).
# AIFORGE_LM_API_KEY=

# Per-role overrides (optional) — one served model per role/port:
#   AIFORGE_DOER_BASE_URL=https://your-box:1234/v1
#   AIFORGE_PLANNER_BASE_URL=https://your-box:1235/v1
#   AIFORGE_SUPERVISOR_BASE_URL=https://your-box:1236/v1
# Generic OpenAI-compat fallback for ALL roles:
#   AIFORGE_OPENAI_COMPAT_BASE_URL=https://your-box:1234/v1
#   AIFORGE_OPENAI_COMPAT_API_KEY=

# ─────────────────────────────── TLS / SSL ───────────────────────────
# Applies ONLY to AIForge's own self-hosted services (model endpoint,
# embed/rerank sidecars, memory/neo4j-http, MCP, local probes, AIForge
# API). Public hosts (GitHub API, arbitrary web/doc fetches) are ALWAYS
# verified regardless of these settings.
#
# PREFERRED — keep verification ON, trust your internal CA / self-signed
# cert by pointing at its PEM. Works for any https host.
# AIFORGE_LLM_CA_BUNDLE=/path/to/internal-ca.pem
#
# OR — relax verification entirely, but only for INTERNAL/LAN hosts
# (loopback, RFC-1918 private IPs, .local/.lan names, and the configured
# base_url hosts above). Default is `true` (verify). Set `false` only for
# a box you control whose self-signed cert you can't add to a CA bundle.
AIFORGE_LLM_SSL_VERIFY=true

# ─────────────────────── Self-hosted sidecars (optional) ─────────────
# Only set if you run these on non-default hosts/ports.
# AIFORGE_EMBED_URL=http://127.0.0.1:8764
# AIFORGE_RERANK_URL=http://127.0.0.1:8765
# AIFORGE_API_BASE=http://localhost:8799
# AIFORGE_MCP_ENDPOINTS=mongo=http://127.0.0.1:8810/mcp,k8s=http://127.0.0.1:8811/mcp

# ─────────────────────────── Confluence (chat) ───────────────────────
# Chat tools to search / read / create / update Confluence pages
# (Server / Data Center). Create a Personal Access Token in Confluence:
#   your avatar → Settings → Personal Access Tokens → Create token.
# Writes (create/update) go through the chat approval gate by default.
# CONFLUENCE_BASE_URL=https://confluence.yourcompany.internal
# CONFLUENCE_TOKEN=your-personal-access-token
# CONFLUENCE_USER=you@company.com        # set ⇒ Basic auth (user+token) instead of Bearer
# CONFLUENCE_INSECURE_TLS=1              # only for a self-signed internal cert

# ─────────────────────────── Jira (chat) ─────────────────────────────
# Chat tools to search / read / create / update / comment on Jira issues
# (Server / Data Center). Create a Personal Access Token in Jira:
#   your avatar → Profile → Personal Access Tokens → Create token.
# Writes (create/update/comment) go through the chat approval gate by default.
# JIRA_BASE_URL=https://jira.yourcompany.internal
# JIRA_TOKEN=your-personal-access-token
# JIRA_USER=you@company.com              # set ⇒ Basic auth (user+token) instead of Bearer
# JIRA_INSECURE_TLS=1                    # only for a self-signed internal cert

# ─────────────────────────── GitLab (chat) ───────────────────────────
# Chat tools to search / read / create / update / comment on GitLab issues
# (self-managed or gitlab.com). Create a Personal/Project/Group Access
# Token: avatar → Edit profile → Access Tokens (read_api, + api for writes).
# Writes (create/update/comment) go through the chat approval gate by default.
# GITLAB_BASE_URL=https://gitlab.yourcompany.internal   # host root, NO /api/v4
# GITLAB_TOKEN=your-access-token
# GITLAB_PROJECT=group/subgroup/project  # optional default project (or numeric id)
# GITLAB_OAUTH=1                         # token is OAuth ⇒ sent as Bearer (default PRIVATE-TOKEN)
# GITLAB_INSECURE_TLS=1                  # only for a self-signed internal cert

# ─────────────────────────── Web search (chat) ───────────────────────
# Keyless web search + page fetch (DuckDuckGo) — the agent searches the
# open web when it's stuck. No API key. Read-only. Enabled by default.
# AIFORGE_WEB_SEARCH_DISABLE=1           # hard-off the web_search / web_fetch tools
# AIFORGE_WEB_SEARCH_RESULTS=5           # default result count
# AIFORGE_WEB_TIMEOUT_S=12               # per-request timeout (seconds)

# ─────────────────────────── Pipeline routing ────────────────────────
# Triage fast-path: a 'trivial' ticket skips enhancer→research→planner→
# verifiers and goes straight to the Doer. Set this to ALWAYS run the full
# pipeline (every agent executes + shows in the trace), regardless of triage.
# AIFORGE_FORCE_FULL_PIPELINE=1

# ─────────────────────────── App serving (chat/pipeline) ─────────────
# The `serve` tool runs an app in the background and returns its endpoint.
# A forgotten service auto-stops after this TTL (seconds); 0 disables.
# AIFORGE_SERVE_TTL_S=1800              # 30 min default
