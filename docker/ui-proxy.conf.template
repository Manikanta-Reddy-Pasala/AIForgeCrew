# The UI's way out of an internal network (`./run.sh --isolated`).
#
# Under --isolated the box sits on a docker network with `internal: true`, and a
# container on such a network cannot publish a port at all. This nginx sits on
# both that network and an ordinary one, so it can accept a connection from the
# host and forward it inward.
#
# A template: nginx fills ${AIFORGE_BOX_SUBNET} from the environment at start
# (the official image's /etc/nginx/templates mechanism); everything else is static. The published address is
# chosen by compose (`${AIFORGE_HOST}:${AIFORGE_PORT}`), not here.
#
# The upstream is plain HTTP by design: this hop never leaves the internal
# docker network, and the app speaks HTTP — terminating TLS here would mean
# issuing a certificate for a name only these two containers can resolve.
server {
  listen 8799;

  # The network allowlist's controller (docker/egress-controller.py). Your
  # browser reaches it through here; the BOX must not — the agent would
  # otherwise allow itself any site. The box's network has a fixed subnet
  # (AIFORGE_BOX_SUBNET in docker-compose.isolated.yml) and every request from it
  # is refused.
  location /egress-admin/ {
    deny ${AIFORGE_BOX_SUBNET};
    allow all;
    # Resolved per request: nginx must still start while the controller is
    # down (the chat keeps working; only the list cannot be changed).
    resolver 127.0.0.11 valid=10s;
    set $egress_ctl http://egress-ctl:8780;
    rewrite ^/egress-admin/(.*)$ /$1 break;
    proxy_pass $egress_ctl;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 64k;
  }

  location / {
    proxy_pass http://aiforge:8799;
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # The chat answers over SSE. Buffering would hold every token until the
    # turn ended, which reads to the user as a hang and then a wall of text.
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }
}
